# Mainnet (pubnet) Contract IDs and Deployment Config
#
# Copy to `.env.mainnet` and fill in AFTER deployment.
# See docs/deployment/MAINNET_DEPLOYMENT.md for the full procedure and the
# production launch gate (an independent security audit is a HARD BLOCKER —
# see docs/security/AUDIT.md).
#
# ┌───────────────────────────────────────────────────────────────────────┐
# │ SECURITY: This file holds PUBLIC contract IDs and non-secret config    │
# │ ONLY. NEVER put a mainnet secret key (S...) here, in CI, or on any      │
# │ always-on server. The deployer/admin must be a hardware wallet or      │
# │ multisig. See MAINNET_DEPLOYMENT.md → "Key custody and admin model".   │
# └───────────────────────────────────────────────────────────────────────┘
#
# What changes vs. .env.testnet.example is annotated with "# CHANGED:" below.

# ── Network ────────────────────────────────────────────────────────────────
# CHANGED: testnet -> mainnet. Register the network in the CLI first:
#   stellar network add mainnet \
#     --rpc-url "<YOUR_MAINNET_RPC_URL>" \
#     --network-passphrase "Public Global Stellar Network ; September 2015"
NETWORK=mainnet

# CHANGED: passphrase differs from testnet's "Test SDF Network ; September 2015".
# (Documented here for reference; set on the `stellar network add` command above.)
# NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# CHANGED: no free public mainnet RPC and no Friendbot. Use an RPC you control
# or a trusted provider. Fund the deployer with REAL XLM and deploy with
# --skip-fund.
# RPC_URL=<YOUR_MAINNET_RPC_URL>

# ── Deployer / Admin ───────────────────────────────────────────────────────
# CHANGED: use a HARDWARE-BACKED / offline identity, not "testnet-deployer".
# This names a `stellar keys` identity; the raw secret NEVER lives in this file.
DEPLOYER_KEY=mainnet-deployer

# CHANGED: admin should be a MULTISIG address, not the single deployer key.
# Set to the multisig after deployment/hardening (see MAINNET_DEPLOYMENT.md).
ADMIN_ADDRESS=

# CHANGED: alias prefix keeps mainnet contracts distinct from testnet aliases.
ALIAS_PREFIX=chioma_mainnet

# CHANGED: write deployed IDs to .env.mainnet, not .env.testnet.
ENV_FILE=.env.mainnet

# ── Deployed Contract IDs (fill in after deployment) ───────────────────────
# Main Rental Agreement Contract
CHIOMA_CONTRACT_ID=

# Dispute Resolution & Arbitration
DISPUTE_RESOLUTION_CONTRACT_ID=

# Security Deposit Escrow
ESCROW_CONTRACT_ID=

# Rent Payment Processing
PAYMENT_CONTRACT_ID=

# Agent Registration & Verification
AGENT_REGISTRY_CONTRACT_ID=

# Property Registration & Verification
PROPERTY_REGISTRY_CONTRACT_ID=

# Tokenized Rent Obligations (NFT)
RENT_OBLIGATION_CONTRACT_ID=

# User Profile Management
USER_PROFILE_CONTRACT_ID=

# ── Fee / Governance Configuration ─────────────────────────────────────────
# CHANGED: confirm production values and get sign-off before deploy — do not
# ship the dev defaults unreviewed.
PLATFORM_FEE_BPS=500
MIN_DISPUTE_VOTES=3

# Separate the fee collector from the protocol admin/pause operator.
# FEE_COLLECTOR_ADDRESS=

# ── Optional: Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_DAILY=1000
RATE_LIMIT_COOLDOWN_SECONDS=60

# ── Optional: Monitoring ───────────────────────────────────────────────────
# Alert on Paused/Unpaused and rate-limit events. See
# docs/security/EMERGENCY-PROCEDURES.md.
MONITOR_EVENTS=true
LOG_LEVEL=info
